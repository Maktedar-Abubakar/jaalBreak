# ---------------------------------------------------------------------------
# ScamShield environment variables
#
# 1. Copy this file and name the copy  .env.local   (same folder)
# 2. Replace the placeholder values with your Supabase project's values:
#    Supabase Dashboard -> Project Settings -> API Keys / Data API
# 3. Restart `npm run dev` after changing this file.
#
# These two values are SAFE to use in the browser. Security comes from
# Row Level Security in the database (supabase/schema.sql).
#
# NEVER put a "service_role" or "sb_secret_..." key here — any VITE_ variable
# is visible to everyone who opens the website.
#
# If both are left empty, ScamShield runs in guest-only mode.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
